# Never put these values in static/app.js or commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/responses
DEEPSEEK_REASONING_EFFORT=none

# Optional isolated vision settings for /scan. When the dedicated key is blank,
# Scan Coach reuses DEEPSEEK_API_KEY without changing the practice scoring model.
SCAN_COACH_DEEPSEEK_API_KEY=
SCAN_COACH_MODEL=deepseek-flash
SCAN_COACH_BASE_URL=https://api.deepseek.com/responses
SCAN_COACH_REASONING_EFFORT=none
SCAN_COACH_TEXT_MODEL=deepseek-v4-pro
SCAN_COACH_TEXT_REASONING_EFFORT=none

# Optional speech-to-text provider. DeepSeek evaluates transcripts; it does not transcribe audio.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-AU

PORT=8765
